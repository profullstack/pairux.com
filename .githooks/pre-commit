#!/bin/sh
#
# PairUX Pre-commit Hook
# Runs lint, typecheck, format, test, and build before allowing commits
# Matches CI/CD checks in .github/workflows/pr-checks.yml
#
# To install: git config core.hooksPath .githooks
# Or run: pnpm setup:hooks
#

set -e

echo "🔍 Running pre-commit checks..."
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Track if any check fails
FAILED=0

# Function to run a check
run_check() {
    local name="$1"
    local cmd="$2"

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "📋 $name"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    if eval "$cmd"; then
        echo "${GREEN}✅ $name passed${NC}"
        echo ""
    else
        echo "${RED}❌ $name failed${NC}"
        echo ""
        FAILED=1
    fi
}

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Skip if no files staged
if [ -z "$STAGED_FILES" ]; then
    echo "No files staged for commit."
    exit 0
fi

# 0. Format and fix staged files (auto-fix)
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📋 Formatting and fixing staged files"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Get staged files that can be processed
LINT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx)$' || true)
PRETTIER_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx|json|md|css|scss|html|yaml|yml)$' || true)

# Run ESLint --fix on JS/TS files
if [ -n "$LINT_FILES" ]; then
    echo "Running ESLint --fix on staged files..."
    echo "$LINT_FILES" | xargs pnpm eslint --fix || true

    # Re-stage the fixed files
    echo "$LINT_FILES" | xargs git add

    echo "${GREEN}✅ ESLint fix complete${NC}"
else
    echo "No lintable files staged."
fi

# Run Prettier on formattable files
if [ -n "$PRETTIER_FILES" ]; then
    echo "Running Prettier on staged files..."
    echo "$PRETTIER_FILES" | xargs pnpm prettier --write

    # Re-stage the formatted files
    echo "$PRETTIER_FILES" | xargs git add

    echo "${GREEN}✅ Prettier formatting complete${NC}"
else
    echo "No formattable files staged."
fi
echo ""

# 1. Linting (verify all issues are fixed)
run_check "ESLint" "pnpm lint"

# 2. Type check (same as CI)
run_check "TypeCheck" "pnpm typecheck"

# 3. Format check (same as CI)
run_check "Format" "pnpm format:check"

# 4. Run tests
run_check "Tests" "pnpm test"

# 5. Build check
run_check "Build" "pnpm build"

# Final result
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $FAILED -eq 1 ]; then
    echo "${RED}❌ Pre-commit checks failed!${NC}"
    echo ""
    echo "Fix the issues above before committing."
    echo "To bypass (not recommended): git commit --no-verify"
    exit 1
else
    echo "${GREEN}✅ All pre-commit checks passed!${NC}"
    echo ""
fi
