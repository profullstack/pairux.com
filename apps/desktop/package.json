{
  "name": "@pairux/desktop",
  "version": "0.21.0",
  "private": true,
  "description": "PairUX Desktop - Screen sharing with remote control",
  "author": "PairUX Team <hello@pairux.com>",
  "homepage": "https://pairux.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/profullstack/pairux.com.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox --ozone-platform-hint=auto --enable-wayland-ime --class=pairux",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-builder",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win",
    "package:linux": "pnpm build && electron-builder --linux",
    "clean": "node -e \"const fs=require('fs');['dist','out','node_modules'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch{}})\""
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@pairux/meeting-copilot": "workspace:*",
    "@pairux/meeting-translation": "workspace:*",
    "@profullstack/remote-input": "workspace:*",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^18.0.9",
    "linkify-react": "^4.4.0",
    "linkifyjs": "^4.4.0",
    "livekit-client": "^2.23.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "optionalDependencies": {
    "@nut-tree-fork/node-mac-permissions": "^2.2.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@pairux/shared-types": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "electron": "^40.10.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
