{
  "name": "@profullstack/pairux",
  "version": "0.1.0",
  "description": "PairUX CLI: bring AI agents into a live PairUX session as participants",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pairux": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "pairux",
    "pair-programming",
    "screen-sharing",
    "ai-agent",
    "claude-code",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/pairux.com.git",
    "directory": "packages/cli"
  },
  "homepage": "https://pairux.com/docs/agents",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
